# HealSense™ Environment Configuration Template

# Backend Configuration
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-32-character-random-string
DATABASE_URL=sqlite:///healsense.db
# For PostgreSQL: postgresql://username:password@localhost:5432/healsense
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000
DEMO_MODE=true

# Private Image Object Storage (Optional for AWS S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=local
STORAGE_BUCKET=healsense-scans
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000
